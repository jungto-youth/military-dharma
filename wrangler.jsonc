{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "military-dharma",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "military-dharma",
      "database_id": "52beb4e2-8d74-4641-a045-27c8df54ac3e",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
